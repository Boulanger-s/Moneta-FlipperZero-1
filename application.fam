App(
    appid="evil_moneta",                 # identifiant interne (peut rester “moneta” si le firmware l’exige, mais on le rend unique)
    name="Evil-Moneta",                  # nom affiché dans le menu du Flipper
    apptype=FlipperAppType.EXTERNAL,
    entry_point="moneta_app",                # le point d’entrée reste le même
    stack_size=4 * 1024,
    fap_category="NFC",                      # catégorie NFC comme demandé
    fap_icon="icons/moneta_10px.png",
    fap_icon_assets="icons",
    fap_author="0x78787878",                 # UID que tu as fourni (utilisé comme auteur dans ce format)
    fap_weburl="https://github.com/at0m-b0mb/Moneta-FlipperZero",
    fap_version="1.0",                       # version demandée
    fap_description=(
        "Version personnalisée d’Evil‑Moneta. "
        
    ),
    sources=[
        "moneta.c",
        "helpers/emv_tlv.c",
        "helpers/emv_card.c",
        "helpers/leak_grade.c",
        "helpers/demo_card.c",
        "helpers/emv_reader.c",
        "helpers/report.c",
        "views/text_fit.c",
        "views/scan_view.c",
        "views/card_view.c",
        "views/log_view.c",
        "views/lesson_view.c",
        "views/transcript_view.c",
        "scenes/moneta_scene.c",
        "scenes/moneta_scene_start.c",
        "scenes/moneta_scene_scan.c",
        "scenes/moneta_scene_result.c",
        "scenes/moneta_scene_report.c",
        "scenes/moneta_scene_details.c",
        "scenes/moneta_scene_transcript.c",
        "scenes/moneta_scene_save.c",
        "scenes/moneta_scene_tally.c",
        "scenes/moneta_scene_fields.c",
        "scenes/moneta_scene_explain.c",
        "scenes/moneta_scene_log.c",
        "scenes/moneta_scene_safe.c",
        "scenes/moneta_scene_lesson.c",
        "scenes/moneta_scene_demo.c",
        "scenes/moneta_scene_settings.c",
        "scenes/moneta_scene_about.c",
    ],
    requires=["gui", "nfc"],
)
