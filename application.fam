App(
    appid="moneta",
    name="Moneta",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="moneta_app",
    stack_size=4 * 1024,
    fap_category="NFC",
    fap_icon="icons/moneta_10px.png",
    fap_icon_assets="icons",
    fap_author="at0m-b0mb",
    fap_weburl="https://github.com/at0m-b0mb/Moneta-FlipperZero",
    fap_version="1.0",
    fap_description="Contactless payment leak educator. Hold your own bank card to the Flipper and Moneta has the same conversation a shop terminal does, then shows you everything the card gave away without being asked: the card number, the expiry date, sometimes your name, sometimes a readable log of where you have been shopping. Grades the exposure A+ to F and explains each field. Read-only: it never writes to the card, authorises anything or makes a payment, and it cannot read your CVV or PIN because those are not on the chip.",
    # The engine is built for the host in test/ as well; keep the firmware
    # build to an explicit list so the test sources never leak into the FAP.
    sources=[
        "moneta.c",
        "helpers/emv_tlv.c",
        "helpers/emv_card.c",
        "helpers/leak_grade.c",
        "helpers/demo_card.c",
        "helpers/emv_reader.c",
        "views/text_fit.c",
        "views/scan_view.c",
        "views/card_view.c",
        "views/log_view.c",
        "views/lesson_view.c",
        "scenes/moneta_scene.c",
        "scenes/moneta_scene_start.c",
        "scenes/moneta_scene_scan.c",
        "scenes/moneta_scene_result.c",
        "scenes/moneta_scene_fields.c",
        "scenes/moneta_scene_explain.c",
        "scenes/moneta_scene_log.c",
        "scenes/moneta_scene_safe.c",
        "scenes/moneta_scene_lesson.c",
        "scenes/moneta_scene_demo.c",
        "scenes/moneta_scene_settings.c",
        "scenes/moneta_scene_about.c",
    ],
    requires=["gui", "nfc"],
)
